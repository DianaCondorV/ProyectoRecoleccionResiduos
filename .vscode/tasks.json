{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "process",
            "label": "C/C++: clang++.exe (C++17) build active file",
            "command": "C:\\ghcup\\ghc\\9.10.3\\mingw\\bin\\clang++.exe",
            "args": [
                "-std=c++17",
                "-static",
                "-Wall",
                "-Wextra",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Compila en C++17 usando clang++ incluido en GHCup."
        },
        {
            "type": "process",
            "label": "C/C++: cl.exe (MSVC C++17) build active file",
            "command": "C:\\Windows\\System32\\cmd.exe",
            "args": [
                "/c",
                "\"C:\\Program Files\\Microsoft Visual Studio\\2022\\Community\\VC\\Auxiliary\\Build\\vcvars64.bat\" && cl.exe /std:c++17 /Zi /EHsc /W4 /nologo /Fe:\"${fileDirname}\\${fileBasenameNoExtension}.exe\" \"${file}\""
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Compila en C++17 usando MSVC de Visual Studio 2022."
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:\\MinGW\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "C:\\MinGW\\bin"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}